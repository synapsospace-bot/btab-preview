<?php

/**
 * @file
 * Functions to support theming in the BTAB Modern theme for Drupal 11.
 */

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_preprocess_html().
 */
function btab_theme_preprocess_html(array &$variables): void {
  // Add body classes for theme styling
  $variables['attributes']['class'][] = 'btab-modern-theme';
  $variables['attributes']['class'][] = 'dark-mode';
}

/**
 * Implements hook_preprocess_page().
 */
function btab_theme_preprocess_page(array &$variables): void {
  // Pass current year to footer
  $variables['current_year'] = date('Y');

  // Contact details variables
  $variables['btab_phone'] = '+359879198455';
  $variables['btab_email'] = 'info@btab.eu';
  $variables['btab_address'] = 'ж.к. Лазур 130, Бургас 8000, България';
  $variables['btab_whatsapp'] = 'https://api.whatsapp.com/send?phone=359879198455';
  $variables['btab_telegram'] = 'https://t.me/btab_eu';
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function btab_theme_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $suggestions[] = 'page__front';
  }
}
